# Dependencies (npm install recreates this)
node_modules/

# Rust build output, regenerated by cargo / cargo tauri build
src-tauri/target/

# Generated by the Tauri build (capability and ACL schemas)
src-tauri/gen/

# Real plan data. Never commit it: it has people's names and roles.
seed/

# SQLite files. The real plan lives in the app data folder, not in the repo.
*.db
*.db-wal
*.db-shm

# OS and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/

# Local secrets
.env
